#!/bin/bash
#SBATCH --partition=rome
#SBATCH --mem=32G
#SBATCH --job-name=FitLinearSVC
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=03:00:00
#SBATCH --output=slurm_fit_svc_%A.out
# Snellius: train the LinearSVC baseline (CPU only).
# Submit with: sbatch fit_linearSVC.job

module purge
module load 2025
module load Anaconda3/2025.06-1

eval "$(conda shell.bash hook)"
conda activate dl_gpu

cd "$HOME/MAM09A2"
python src/models/fit_linearSVC.py
